<Project Sdk="Microsoft.NET.Sdk">

  <!-- The menu: one self-contained trimmed file per platform. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>cli</AssemblyName>
    <RootNamespace>ClaudeAccounts</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Multi_calude</Product>
    <Description>Launcher for Claude Code with several accounts</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0162</NoWarn>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\*.cs" />
  </ItemGroup>

</Project>
